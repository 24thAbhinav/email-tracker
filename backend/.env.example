# Copy this file to .env and fill in your values

# ── LLM (OpenCode Go) ────────────────────────────────
OPENCODE_API_KEY=
# Optional stable session id for routing/prompt caching (defaults to a random uuid)
OPENCODE_SESSION_ID=

# ── Database ─────────────────────────────────────────
DATABASE_URL=sqlite:///./job_tracker.db

# ── Gmail OAuth ──────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback
GMAIL_TOKEN_PATH=token.json
GMAIL_CREDENTIALS_PATH=credentials.json

# ── Gmail push (Pub/Sub) ─────────────────────────────
# Full resource name of the Pub/Sub topic Gmail publishes to, e.g.
# projects/<project-id>/topics/<topic-name>
GMAIL_PUBSUB_TOPIC=
# Mailbox/account identifier used as the sync-cursor key ("me" = authorized user)
GMAIL_SYNC_ACCOUNT=me
# Max messages fetched during a full resync
GMAIL_FULL_SYNC_MAX_MESSAGES=50

# ── API / CORS ───────────────────────────────────────
# Comma-separated allowed frontend origins
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:3000


# ── LangSmith Tracing ──
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=job-tracker
